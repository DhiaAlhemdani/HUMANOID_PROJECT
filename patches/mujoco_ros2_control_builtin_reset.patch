+void MujocoRos2Control::init_simulation_reset()
+{
+  reset_simulation_srv_ = node_->create_service<std_srvs::srv::Trigger>(
+    "~/reset_simulation",
+    std::bind(
+      &MujocoRos2Control::simulation_reset_callback, this, std::placeholders::_1,
+      std::placeholders::_2));
+  resume_after_reset_srv_ = node_->create_service<std_srvs::srv::Trigger>(
+    "~/resume_after_reset",
+    std::bind(
+      &MujocoRos2Control::simulation_resume_callback, this, std::placeholders::_1,
+      std::placeholders::_2));
+  RCLCPP_INFO(
+    logger_, "Built-in MuJoCo reset services ready on ~/reset_simulation and ~/resume_after_reset");
+}
+
+void MujocoRos2Control::simulation_reset_callback(
+  const std::shared_ptr<std_srvs::srv::Trigger::Request> /*request*/,
+  std::shared_ptr<std_srvs::srv::Trigger::Response> response)
+{
+  std::unique_lock<std::mutex> lock(simulation_reset_mutex_);
+  if (simulation_reset_pending_) {
+    response->success = false;
+    response->message = "A simulation reset is already pending";
+    return;
+  }
+  simulation_reset_complete_ = false;
+  simulation_reset_pending_ = true;
+  if (!simulation_reset_cv_.wait_for(lock, std::chrono::seconds(5), [this]() {
+      return simulation_reset_complete_;
+    })) {
+    simulation_reset_pending_ = false;
+    response->success = false;
+    response->message = "Timed out waiting for the MuJoCo physics loop";
+    return;
+  }
+  simulation_reset_pending_ = false;
+  response->success = true;
+  response->message = "MuJoCo mj_resetData applied; configured spawn pose restored and physics paused";
+}
+
+void MujocoRos2Control::simulation_resume_callback(
+  const std::shared_ptr<std_srvs::srv::Trigger::Request> /*request*/,
+  std::shared_ptr<std_srvs::srv::Trigger::Response> response)
+{
+  hold_physics_after_reset_.store(false, std::memory_order_release);
+  response->success = true;
+  response->message = "MuJoCo physics resumed after controller reactivation";
+  RCLCPP_INFO(logger_, "%s", response->message.c_str());
+}
+
+void MujocoRos2Control::apply_simulation_reset()
+{
+  {
+    std::lock_guard<std::mutex> lock(simulation_reset_mutex_);
+    if (!simulation_reset_pending_) return;
+  }
+
+  // Use MuJoCo's built-in reset for the complete scene state, then restore only the
+  // configured spawn qpos that differs from the MJCF's authored qpos0.
+  mj_resetData(mj_model_, mj_data_);
+  std::copy(initial_qpos_.begin(), initial_qpos_.end(), mj_data_->qpos);
+  mj_forward(mj_model_, mj_data_);
+  // Keep physics frozen until ros2_control has reactivated the controllers.
+  hold_physics_after_reset_.store(true, std::memory_order_release);
+  active_external_wrenches_.clear();
+  {
+    std::lock_guard<std::mutex> lock(external_wrench_mutex_);
+    pending_external_wrenches_.clear();
+  }
+  last_update_sim_time_ros_ = rclcpp::Time(0, 0, RCL_ROS_TIME);
+  last_mujoco_publish_time_ = rclcpp::Time(0, 0, RCL_ROS_TIME);
+  last_gt_pub_time_ = rclcpp::Time(0, 0, RCL_ROS_TIME);
+
+  {
+    std::lock_guard<std::mutex> lock(simulation_reset_mutex_);
+    simulation_reset_pending_ = false;
+    simulation_reset_complete_ = true;
+  }
+  simulation_reset_cv_.notify_all();
+  RCLCPP_INFO(logger_, "Applied built-in MuJoCo reset and restored configured spawn qpos");
+}
+
 void MujocoRos2Control::init_object_reset()
